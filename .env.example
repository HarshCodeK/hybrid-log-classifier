# Copy to .env and fill in. The project runs without this file:
# regex and ML tiers work, and unmatched lines come back as Unknown.

# Enables the LLM tier. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to qwen/qwen3.8-27b, which measured 15/15 on the
# held-out tier-3 benchmark. Override if a different model becomes a better
# fit -- see docs/03-tech-stack.md for the full comparison.
GROQ_MODEL=qwen/qwen3.8-27b
